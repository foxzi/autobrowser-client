 {
  "name": "browser_run_script",
  "description": "Run a multi-step scenario (YAML) in one call: variables, if/try/forEach/while, retries.\n\n        Pass exactly one of script or file. Runs on the current browser session: the\n        scenario `session` block is ignored. `include` paths are relative to the file's\n        directory, or to the working directory for inline script text.\n        Returns JSON {success, steps, vars}.\n        ",
  "inputSchema": {
   "properties": {
    "script": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Scenario as YAML text (JSON also works)",
     "title": "Script"
    },
    "file": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Path of a scenario file",
     "title": "File"
    },
    "vars": {
     "anyOf": [
      {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Variables, override the scenario vars",
     "title": "Vars"
    },
    "page_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Tab id from browser_tabs; first tab by default",
     "title": "Page Id"
    }
   },
   "type": "object",
   "title": "browser_run_scriptArguments"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "type": "object",
   "title": "browser_run_scriptOutput"
  }
 },
