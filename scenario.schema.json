    "ifBlock": {
      "type": "object",
      "description": "Conditional",
      "additionalProperties": false,
      "required": [
        "if",
        "then"
      ],
      "properties": {
        "if": {
          "$ref": "#/$defs/condition"
        },
        "then": {
          "$ref": "#/$defs/steps"
        },
        "else": {
          "$ref": "#/$defs/steps"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "tryBlock": {
      "type": "object",
      "description": "Error handling; the error is available as ${error.message} in catch",
      "additionalProperties": false,
      "required": [
        "try"
      ],
      "properties": {
        "try": {
          "$ref": "#/$defs/steps"
        },
        "catch": {
          "$ref": "#/$defs/steps"
        },
        "finally": {
          "$ref": "#/$defs/steps"
        },
        "name": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "catch"
          ]
        },
        {
          "required": [
            "finally"
          ]
        }
      ]
    },
    "forEachBlock": {
      "type": "object",
      "description": "Loop over a list or a variable holding a list",
      "additionalProperties": false,
      "required": [
        "forEach",
        "do"
      ],
      "properties": {
        "forEach": {
          "anyOf": [
            {
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "List or \"${var}\""
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$",
          "default": "item"
        },
        "do": {
          "$ref": "#/$defs/steps"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "repeatBlock": {
      "type": "object",
      "description": "Repeat N times",
      "additionalProperties": false,
      "required": [
        "repeat",
        "do"
      ],
      "properties": {
        "repeat": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "description": "Count or \"${var}\""
        },
        "do": {
          "$ref": "#/$defs/steps"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "whileBlock": {
      "type": "object",
      "description": "Loop while the condition holds",
      "additionalProperties": false,
      "required": [
        "while",
        "do"
      ],
      "properties": {
