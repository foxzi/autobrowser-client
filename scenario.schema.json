          "$ref": "#/$defs/condition"
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "do": {
          "$ref": "#/$defs/steps"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "includeStep": {
      "type": "object",
      "description": "Insert steps of another file (relative path inside the scenario directory)",
      "additionalProperties": false,
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
