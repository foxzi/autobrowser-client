{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "autobrowser-client scenario",
  "description": "Schema for CLI script scenarios (editor support only; the pydantic models in autobrowser_client/scenario.py are authoritative)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps"
  ],
  "properties": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headless": {
          "type": "boolean",
          "default": true
        },
        "profile": {
          "type": "string"
        },
        "profileDir": {
          "type": "string"
        },
        "userAgent": {
          "type": "string"
        },
        "proxy": {
          "type": "string",
          "description": "Proxy URL, e.g. socks5://user:pass@host:port"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Browser viewport size, e.g. {width: 1920, height: 1080}"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "preserveSession": {
          "type": "boolean",
          "default": false
        },
        "fingerprint": {
          "description": "Fingerprint overrides, or a boolean to toggle",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/fingerprint"
            }
          ]
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "Default variables, available as ${name}; overridden by --var"
    },
    "errorArtifacts": {
      "type": "string",
      "description": "Directory for screenshots and HTML of failed steps"
    },
    "stopOnError": {
      "type": "boolean",
      "default": true
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        }
      }
    },
    "steps": {
      "$ref": "#/$defs/steps",
      "description": "Steps and control blocks"
    }
  },
  "$defs": {
    "text": {
      "description": "String (numbers are accepted and converted to strings)",
      "type": [
        "string",
        "number"
      ]
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer"
        },
        "canvas": {
          "type": "boolean"
        },
        "webgl": {
          "type": "boolean"
        },
        "webglVendor": {
          "type": "string"
        },
        "webglRenderer": {
          "type": "string"
        },
        "audio": {
          "type": "boolean"
        },
        "clientRects": {
          "type": "boolean"
        },
        "fonts": {
          "type": "boolean"
        }
      }
    },
    "locator": {
      "description": "String shorthand (\"#id\", \".class\", \"//xpath\", \"css selector\", \"type=value\") or {type, value}",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "css",
                "xpath",
                "id",
                "name",
                "class",
                "text",
                "attribute",
                "ref"
              ]
            },
            "value": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "waitUntil": {
      "enum": [
        "domcontentloaded",
        "load",
        "networkidle",
        "visible",
        "hidden"
      ]
    },
    "condition": {
      "type": "object",
      "description": "Check used by if, while and assert: exactly one of exists, visible, text, url, urlMatches, title, var, not, all, any",
      "additionalProperties": false,
      "properties": {
        "exists": {
          "$ref": "#/$defs/locator"
        },
        "visible": {
          "$ref": "#/$defs/locator"
        },
        "text": {
          "$ref": "#/$defs/text",
          "description": "Page text contains"
        },
        "url": {
          "$ref": "#/$defs/text",
          "description": "Current URL contains"
        },
        "urlMatches": {
          "type": "string",
          "description": "Current URL matches regex"
        },
        "title": {
          "$ref": "#/$defs/text",
          "description": "Page title contains"
        },
        "var": {
          "type": "string",
          "description": "Variable name, combine with equals / contains / matches"
        },
        "equals": {
          "description": "Variable equals this value (any type)"
        },
        "contains": {
          "$ref": "#/$defs/text"
        },
        "matches": {
          "type": "string",
          "description": "Regex"
        },
        "not": {
          "$ref": "#/$defs/condition"
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Milliseconds to wait for a leaf condition; not allowed with not/all/any"
        }
      },
      "oneOf": [
        {
          "required": [
            "exists"
          ]
        },
        {
          "required": [
            "visible"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "urlMatches"
          ]
        },
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "var"
          ]
        },
        {
          "required": [
            "not"
          ]
        },
        {
          "required": [
            "all"
          ]
        },
        {
          "required": [
            "any"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "equals"
                ]
              },
              {
                "required": [
                  "contains"
                ]
              },
              {
                "required": [
                  "matches"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "var"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "not"
                ]
              },
              {
                "required": [
                  "all"
                ]
              },
              {
                "required": [
                  "any"
                ]
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "timeout"
              ]
            }
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stepOrBlock"
      }
    },
    "stepOrBlock": {
      "anyOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "$ref": "#/$defs/ifBlock"
        },
        {
          "$ref": "#/$defs/tryBlock"
        },
        {
          "$ref": "#/$defs/forEachBlock"
        },
        {
          "$ref": "#/$defs/repeatBlock"
        },
        {
          "$ref": "#/$defs/whileBlock"
        },
        {
          "$ref": "#/$defs/includeStep"
        }
      ]
    },
    "step": {
      "type": "object",
      "description": "Single action: canonical {action: ...} form or a shorthand verb-key form such as `click: \"#sel\"`",
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Action to perform",
          "enum": [
            "open",
            "wait",
            "find",
            "click",
            "fill",
            "type",
            "press",
            "scroll",
            "screenshot",
            "get-content",
            "get-cookies",
            "get-headers",
            "save",
            "browse-tabs",
            "solve-challenge",
            "hover",
            "dblclick",
            "focus",
            "clear",
            "check",
            "uncheck",
            "submit",
            "select",
            "upload",
            "evaluate",
            "history",
            "wait-text",
            "extract",
            "find-all",
            "read",
            "mouse-move",
            "mouse-scroll-to",
            "mouse-random",
            "set",
            "assert",
            "fail"
          ]
        },
        "name": {
          "type": "string",
          "description": "Step label shown in results"
        },
        "page": {
          "type": "string",
          "description": "Page (tab) id"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "key": {
          "type": "string",
          "description": "Key name for press"
        },
        "format": {
          "enum": [
            "html",
            "text"
          ]
        },
        "waitUntil": {
          "$ref": "#/$defs/waitUntil"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds"
        },
        "deltaX": {
          "type": "integer"
        },
        "deltaY": {
          "type": "integer"
        },
        "delay": {
          "type": "integer",
          "minimum": 0
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "fullPage": {
          "type": "boolean",
          "default": false
        },
        "file": {
          "type": "string"
        },
        "stopOnError": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Options for select (alternative to value)"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Files for upload"
        },
        "script": {
          "type": "string",
          "description": "JavaScript for evaluate"
        },
        "direction": {
          "enum": [
            "back",
            "forward",
            "reload"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "gone": {
          "type": "boolean",
          "default": false,
          "description": "wait-text: wait until the text disappears"
        },
        "attribute": {
          "type": "string",
          "description": "Attribute to read/extract"
        },
        "all": {
          "type": "boolean",
          "default": false
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "steps": {
          "type": "integer",
          "description": "Number of intermediate mouse-move points"
        },
        "startX": {
          "type": "number",
          "default": 0
        },
        "startY": {
          "type": "number",
          "default": 0
        },
        "endX": {
          "type": "number"
        },
        "endY": {
          "type": "number"
        },
        "durationMs": {
          "type": "integer"
        },
        "jitter": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*$",
          "description": "Store the result in a variable (extract, evaluate, read, find-all, get-content, get-cookies, get-headers)"
        },
        "vars": {
          "type": "object",
          "description": "Variables for set"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "message": {
          "type": "string",
          "description": "Message for fail"
        },
        "retry": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "retryDelay": {
          "type": "integer",
          "minimum": 0,
          "default": 1000
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "open": {
          "description": "Shorthand: URL to open",
          "$ref": "#/$defs/text"
        },
        "wait": {
          "description": "Shorthand: milliseconds (integer) or a load state",
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "enum": [
                "load",
                "domcontentloaded",
                "networkidle"
              ]
            }
          ]
        },
        "fill": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Shorthand: [locator, value]",
          "prefixItems": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "type": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Shorthand: [locator, value]",
          "prefixItems": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "press": {
          "description": "Shorthand: key name",
          "$ref": "#/$defs/text"
        },
        "select": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Shorthand: [locator, option] or [locator, [options]]",
          "prefixItems": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              ]
            }
          ]
        },
        "upload": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Shorthand: [locator, file or [files]]",
          "prefixItems": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              ]
            }
          ]
        },
        "evaluate": {
          "description": "Shorthand: JavaScript to run",
          "$ref": "#/$defs/text"
        },
        "history": {
          "description": "Shorthand: direction",
          "enum": [
            "back",
            "forward",
            "reload"
          ]
        },
        "wait-text": {
          "description": "Shorthand: text to wait for",
          "$ref": "#/$defs/text"
        },
        "fail": {
          "description": "Shorthand: failure message",
          "$ref": "#/$defs/text"
        },
        "assert": {
          "description": "Shorthand: condition",
          "$ref": "#/$defs/condition"
        },
        "set": {
          "description": "Shorthand: variables to set",
          "type": "object"
        },
        "screenshot": {
          "description": "Shorthand: output file",
          "type": "string"
        },
        "save": {
          "description": "Shorthand: output file",
          "type": "string"
        },
        "find": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "click": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "hover": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "dblclick": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "focus": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "clear": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "check": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "uncheck": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "submit": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "extract": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "find-all": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "read": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "mouse-scroll-to": {
          "description": "Shorthand: locator",
          "$ref": "#/$defs/locator"
        },
        "get-content": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        },
        "get-cookies": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        },
        "get-headers": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        },
        "browse-tabs": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        },
        "solve-challenge": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        },
        "mouse-move": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        },
        "mouse-random": {
          "description": "Shorthand: use null (or empty value)",
          "type": "null"
        }
      },
      "anyOf": [
        {
          "required": [
            "action"
          ]
        },
        {
          "required": [
            "open"
          ]
        },
        {
          "required": [
            "wait"
          ]
        },
        {
          "required": [
            "find"
          ]
        },
        {
          "required": [
            "click"
          ]
        },
        {
          "required": [
            "fill"
          ]
        },
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "press"
          ]
        },
        {
          "required": [
            "scroll"
          ]
        },
        {
          "required": [
            "screenshot"
          ]
        },
        {
          "required": [
            "get-content"
          ]
        },
        {
          "required": [
            "get-cookies"
          ]
        },
        {
          "required": [
            "get-headers"
          ]
        },
        {
          "required": [
            "save"
          ]
        },
        {
          "required": [
            "browse-tabs"
          ]
        },
        {
          "required": [
            "solve-challenge"
          ]
        },
        {
          "required": [
            "hover"
          ]
        },
        {
          "required": [
            "dblclick"
          ]
        },
        {
          "required": [
            "focus"
          ]
        },
        {
          "required": [
            "clear"
          ]
        },
        {
          "required": [
            "check"
          ]
        },
        {
          "required": [
            "uncheck"
          ]
        },
        {
          "required": [
            "submit"
          ]
        },
        {
          "required": [
            "select"
          ]
        },
        {
          "required": [
            "upload"
          ]
        },
        {
          "required": [
            "evaluate"
          ]
        },
        {
          "required": [
            "history"
          ]
        },
        {
          "required": [
            "wait-text"
          ]
        },
        {
          "required": [
            "extract"
          ]
        },
        {
          "required": [
            "find-all"
          ]
        },
        {
          "required": [
            "read"
          ]
        },
        {
          "required": [
            "mouse-move"
          ]
        },
        {
          "required": [
            "mouse-scroll-to"
          ]
        },
        {
          "required": [
            "mouse-random"
          ]
        },
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "assert"
          ]
        },
        {
          "required": [
            "fail"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "open"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "find",
                  "click",
                  "hover",
                  "dblclick",
                  "focus",
                  "clear",
                  "check",
                  "uncheck",
                  "submit",
                  "extract",
                  "find-all",
                  "read",
                  "mouse-scroll-to",
                  "fill",
                  "type",
                  "select",
                  "upload"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "locator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "fill",
                  "type"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "select"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "options"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "upload"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "files"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "evaluate"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "script"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "history"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "direction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "wait-text"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "text"
